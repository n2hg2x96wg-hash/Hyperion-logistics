# ---- Required (Vercel > Project > Settings > Environment Variables) ----
FIREBASE_SERVICE_ACCOUNT=      # service-account JSON (raw or base64). Server only.
FIREBASE_PROJECT_ID=hyperion-logistics
ADMIN_PASSWORD=                # admin login password (replaces the old hard-coded one; rotate it!)
SESSION_SECRET=                # 32+ random chars, signs admin session cookies

# ---- Optional ----
# Map tiles. Default (nothing set) = OpenStreetMap standard tiles, no key needed.
# For a commercial/high-traffic site use a keyed provider with a PUBLIC, domain-restricted key:
MAP_PROVIDER=                  # maptiler | stadia | mapbox | osm
MAP_TILE_KEY=                  # public key, restrict it to your domain in the provider's dashboard
MAP_TILE_URL=                  # optional fully custom XYZ template, may contain {key}; overrides MAP_PROVIDER
MAP_TILE_ATTRIBUTION=          # required with MAP_TILE_URL
MAP_TILE_MAX_ZOOM=
LIVE_LOCATION_MAX_AGE_MIN=30   # a position newer than this shows as "Live"
RECENT_LOCATION_MAX_AGE_HOURS=24  # newer than this shows "Recently updated", older "Last known location"
REALTIME_SSE=on                # "off" => clients use polling only
CLIENT_POLL_MS=20000
GEOCODER=on                    # "off" disables server-side geocoding of origin/destination
NOTIFY_WEBHOOK_URL=            # forwards shipment events; no webhook => no notifications sent
NOTIFY_WEBHOOK_SECRET=
PROVIDER_GENERIC_SECRET=       # HMAC secret for POST /api/provider?provider=generic
