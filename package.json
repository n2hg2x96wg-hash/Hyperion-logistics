{
  "name": "hyperion-logistics",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Hyperion Logistics - static frontend with Vercel serverless API",
  "scripts": {
    "dev": "STORE=memory node dev-server.js",
    "test": "node --test test/api.test.js test/command-center.test.js test/phase3.test.js test/notify.test.js test/i18n.test.js test/customer.test.js",
    "test:emulator": "STORE=firestore-emulator node --test --test-concurrency=1 test/api.test.js test/command-center.test.js",
    "dev:emulator": "STORE=firestore-emulator node dev-server.js",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/site.e2e.mjs test/e2e/i18n.e2e.mjs test/e2e/account.e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0"
  }
}
